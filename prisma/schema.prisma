
generator client {
  provider             = "prisma-client"
  output               = "../generated/prisma"
  importFileExtension  = "ts"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  ADMIN
  RECEPTIONIST
  // SaaS platform owner. Never assigned from client input — promote a user
  // with `node scripts/make-super-admin.mjs <email>` only.
  SUPER_ADMIN
}

enum Timing {
  MORNING
  AFTERNOON
  EVENING
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  INACTIVE
  FROZEN
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  OTHER
}

model Gym {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?    @db.Text
  createdAt DateTime   @default(now())
  users     User[]
  members   Member[]
  plans     MembershipPlan[]
  expenses  Expense[]
  attendances Attendance[]

  // SaaS subscription (platform billing) — kept separate from the gym's own
  // MembershipPlan products that gym owners sell to their customers.
  subscription       GymSubscription?
  trialRecords       TrialRecord[]
  subscriptionAuditLogs SubscriptionAuditLog[]
  subscriptionPayments  SubscriptionPayment[]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  gymId         String?
  role          Role      @default(ADMIN)
  gym           Gym?      @relation(fields: [gymId], references: [id], onDelete: SetNull)
  sessions      Session[]
  accounts      Account[]

  @@index([gymId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Member {
  id               String      @id @default(cuid())
  gymId            String
  gym              Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberCode       String
  name             String
  phone            String
  email            String?
  dateOfBirth      DateTime?
  gender           String?
  address          String?     @db.Text
  emergencyContact String?
  emergencyPhone   String?
  joinedAt         DateTime    @default(now())
  timing           Timing      @default(MORNING)
  notes            String?     @db.Text
  archivedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  memberships      Membership[]
  payments         Payment[]
  attendances Attendance[]

  @@unique([gymId, memberCode])
  @@index([gymId, name])
  @@index([gymId, phone])
}

model MembershipPlan {
  id            String       @id @default(cuid())
  gymId         String
  gym           Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name          String
  durationMonths Int
  pricePaise    Int
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  memberships  Membership[]

  @@unique([gymId, name])
  @@index([gymId, isActive])
}

model Membership {
  id               String           @id @default(cuid())
  gymId            String
  memberId         String
  member           Member           @relation(fields: [memberId], references: [id], onDelete: Restrict)
  planId           String
  plan             MembershipPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  startDate        DateTime
  endDate          DateTime
  pricePaise       Int
  discountPaise    Int              @default(0)
  status           MembershipStatus @default(ACTIVE)
  frozenAt         DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime         @default(now())
  allocations      PaymentAllocation[]

  @@index([gymId, status, endDate])
  @@index([memberId, endDate])
}

model Payment {
  id             String        @id @default(cuid())
  gymId          String
  memberId       String
  member         Member        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  amount          Float
  paymentMode    PaymentMode
  receiptNumber  String
  reference      String?
  paymentDate    DateTime
  paidAt         DateTime      @default(now())
  status         String        @default("SUCCESS")
  allocations    PaymentAllocation[]

  @@unique([gymId, receiptNumber])
  @@index([gymId, paidAt])
  @@index([memberId, paidAt])
}

model PaymentAllocation {
  id           String     @id @default(cuid())
  paymentId    String
  payment      Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  amount  Float

  @@unique([paymentId, membershipId])
  @@index([membershipId])
}

model Expense {
  id    Int     @id @default(autoincrement()) 
  gymId        String
  gym          Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name         String
  category     String
  description  String?     @db.Text
  amount       Float
  expenseDate  DateTime    @default(now())
  createdAt    DateTime    @default(now())

  @@index([gymId, expenseDate])
  @@index([gymId, category])
}




enum AttendanceMarkingMethod {
  MANUAL
  QR_CODE
  BIOMETRIC
}

model Attendance {
  id             String                  @id @default(cuid())
  gymId          String
  memberId       String
  attendanceDate DateTime                @db.Date
  checkInAt      DateTime                @default(now())
  checkOutAt     DateTime?
  checkInNotes   String?
  checkOutNotes  String?
  markingMethod  AttendanceMarkingMethod @default(MANUAL)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)

  @@index([gymId, attendanceDate])
  @@index([gymId, memberId, attendanceDate])
  @@index([memberId, checkOutAt])
}

// ---------------------------------------------------------------------------
// SaaS subscription & billing (platform-level, NOT the gym's own memberships)
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELLED
  PAST_DUE
}

enum SubscriptionPaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  DISPUTED
}

enum TrialRecordType {
  INITIAL
  EXTENSION
}

/// SaaS plan sold by the platform owner. `code` makes seeding idempotent.
/// Prices are always stored in integer paise.
model SubscriptionPlan {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?  @db.Text
  pricePaise     Int
  currency       String   @default("INR")
  durationMonths Int
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(0)
  features       String[]
  maxStaff       Int?
  maxBranches    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions GymSubscription[]
  payments      SubscriptionPayment[]

  @@index([isActive, displayOrder])
}

/// One SaaS subscription row per gym. The unique gymId constraint is what
/// makes concurrent duplicate trial/payment grants impossible: the losing
/// transaction hits P2002 and rolls back.
/// Price/name are snapshotted at purchase time so later plan edits by the
/// SaaS owner never change existing purchase terms.
model GymSubscription {
  id                 String             @id @default(cuid())
  gymId              String             @unique
  gym                Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  planId             String?
  plan               SubscriptionPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  status             SubscriptionStatus @default(TRIALING)
  planNameSnapshot   String?
  pricePaise         Int                @default(0)
  currency           String             @default("INR")
  trialStartsAt      DateTime?
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  paymentProvider    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  payments SubscriptionPayment[]

  @@index([status, currentPeriodEnd])
  @@index([trialEndsAt])
}

/// Financial history for SaaS subscription payments. Rows are never deleted.
/// orderId/paymentId are provider-verified and unique, which makes
/// verification and webhook processing idempotent.
model SubscriptionPayment {
  id             String                    @id @default(cuid())
  gymId          String
  gym            Gym                       @relation(fields: [gymId], references: [id], onDelete: Restrict)
  // Nullable: a payment order can be created before any subscription row
  // exists (e.g. a gym that never started a trial). Bound on activation.
  subscriptionId String?
  subscription   GymSubscription?          @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  planId         String?
  plan           SubscriptionPlan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  amount         Float
  currency       String                    @default("INR")
  status         SubscriptionPaymentStatus @default(CREATED)
  provider       String                    @default("razorpay")
  orderId        String?                   @unique
  paymentId      String?                   @unique
  signature      String?
  failureReason  String?                   @db.Text
  verifiedAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([gymId, createdAt])
  @@index([subscriptionId, status])
}

/// Duplicate-webhook protection. The provider event id is the primary key:
/// re-delivering the same webhook hits a unique violation and is skipped.
model SubscriptionWebhookEvent {
  id          String    @id
  provider    String    @default("razorpay")
  type        String
  payload     Json?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

/// Durable trial history / eligibility record. INITIAL rows prove a gym has
/// consumed its one allowed trial; EXTENSION rows record audited admin grants.
model TrialRecord {
  id            String          @id @default(cuid())
  gymId         String
  gym           Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  type          TrialRecordType
  startsAt      DateTime
  endsAt        DateTime
  reason        String?         @db.Text
  grantedById   String?
  grantedByRole String?
  source        String          @default("SELF_SERVICE")
  createdAt     DateTime        @default(now())

  @@index([gymId, createdAt])
  @@index([type, createdAt])
}

/// Singleton row (id = "singleton") holding platform trial/billing settings.
model SubscriptionSetting {
  id                       String    @id @default("singleton")
  trialEnabled             Boolean   @default(true)
  trialDurationDays        Int       @default(14)
  trialPricePaise          Int       @default(0)
  trialRequiresPaymentMethod Boolean  @default(false)
  cancellationPolicy       String    @default("END_OF_PERIOD") // END_OF_PERIOD | IMMEDIATE
  reminderDaysBefore       Int       @default(3)
  updatedById              String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

/// Append-only audit trail for plan changes, settings changes, trial grants,
/// manual access grants, cancellations and payment status changes.
model SubscriptionAuditLog {
  id             String          @id @default(cuid())
  action         String
  gymId          String?
  gym            Gym?            @relation(fields: [gymId], references: [id], onDelete: SetNull)
  planId         String?
  subscriptionId String?
  actorUserId    String?
  actorEmail     String?
  actorRole      String?
  reason         String?         @db.Text
  details        Json?
  createdAt      DateTime        @default(now())

  @@index([gymId, createdAt])
  @@index([action, createdAt])
}
