# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGINS="http://localhost:3000,https://darkgoldgym.duckdns.org"

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/gymcrm?schema=public"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="your_better_auth_secret_minimum_32_chars"
BETTER_AUTH_URL="https://darkgoldgym.duckdns.org"

# Razorpay Payment Gateway Credentials
# Find these in Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"

# Razorpay Webhook Secret
# Set in Razorpay Dashboard > Settings > Webhooks (Url: https://<domain>/api/v1/subscriptions/webhook)
RAZORPAY_WEBHOOK_SECRET="your_custom_webhook_secret_string"

# Subscription / Trial Defaults
PLATFORM_TRIAL_DAYS=7
PLATFORM_GRACE_DAYS=3

# Cron Token (Optional: for triggering internal cron runner over HTTP)
CRON_SECRET_TOKEN="your_cron_secret_token"
