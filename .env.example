# Gym CRM SaaS — Backend environment variables
# Copy this file to .env and fill in real values. Never commit real secrets.

# Port (optional, default 5000)
PORT=5000

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@host:port/db?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:port/db"

# Better Auth (session cookies)
BETTER_AUTH_SECRET="<min-32-chars-random-string>"
BETTER_AUTH_URL="http://localhost:5000"
CLIENT_ORIGIN="http://localhost:3000,http://localhost:5000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email OTP (nodemailer SMTP). Until set, OTPs are logged to the console.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Gym CRM <noreply@example.com>"

# ---------------------------------------------------------------------------
# Razorpay (SaaS subscription payments)
# Keep secrets server-side. Never return RAZORPAY_KEY_SECRET or
# RAZORPAY_WEBHOOK_SECRET to the frontend.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_<your_key_id>"
RAZORPAY_KEY_SECRET="<your_key_secret>"
RAZORPAY_WEBHOOK_SECRET="<your_webhook_secret>"

# ---------------------------------------------------------------------------
# Subscription expiry reconciliation job
# ---------------------------------------------------------------------------
# Set to "true" to disable the background expiry job (entitlement is still
# checked on every API request).
DISABLE_EXPIRY_JOB="false"
SUBSCRIPTION_RECONCILE_INTERVAL_MS="900000"
