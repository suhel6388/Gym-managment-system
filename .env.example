# -----------------------------------------------------------------------------
# DarkGoldGym backend — copy to .env and fill in real values.
# Never commit the filled .env.
# -----------------------------------------------------------------------------

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Direct, non-pooled connection used by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Better Auth (sessions, OAuth, password reset)
# Minimum 32 characters. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# Public origin of THIS API (not the frontend), e.g. http://localhost:5000
BETTER_AUTH_URL="http://localhost:5000"
# Comma-separated browser origins allowed to call the API.
CLIENT_ORIGIN="http://localhost:3000"
PORT=5000
# Optional explicit public API origin (custom domain / reverse proxy).
# PUBLIC_API_URL="https://api.your-gym-domain.com"

# Google sign-in (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email / OTP (optional locally: when empty, OTPs are logged to the console)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="DarkGoldGym <no-reply@your-domain.com>"
# Set true in local development to print OTPs instead of sending them.
# EMAIL_LOG_OTPS=true

# -----------------------------------------------------------------------------
# PDF receipts
# -----------------------------------------------------------------------------
# Public API origin that Meta's servers can reach. Needed for the fallback
# receipt link and for the QR code inside the PDF.
RECEIPT_PUBLIC_BASE_URL="http://localhost:5000"
# Secret for short-lived public receipt links. Use a long random value in
# production; defaults to BETTER_AUTH_SECRET when unset.
RECEIPT_LINK_SECRET="replace-with-another-long-random-secret"
RECEIPT_LINK_TTL_DAYS=7
# Optional custom TTF fonts (absolute paths) so the PDF can print ₹.
# Without these the PDF prints "Rs." using its bundled font.
# RECEIPT_PDF_FONT="/absolute/path/Regular.ttf"
# RECEIPT_PDF_FONT_BOLD="/absolute/path/Bold.ttf"

# -----------------------------------------------------------------------------
# WhatsApp Business Cloud API (Meta) — optional automatic PDF delivery
# -----------------------------------------------------------------------------
# Meta → App Dashboard → WhatsApp → API Setup.
# Use a permanent System User token in production, not the 24-hour test token.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"

# -----------------------------------------------------------------------------
# Google Gemini AI Assistant (Free model: gemini-1.5-flash / gemini-2.0-flash)
# -----------------------------------------------------------------------------
# Get a free Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
# Recommended free models: "gemini-1.5-flash" or "gemini-2.0-flash"
GEMINI_MODEL="gemini-1.5-flash"
DEFAULT_AI_CHAT_LIMIT=3

# -----------------------------------------------------------------------------
# Platform-owner bootstrap (one-time use; never needed by the running API)
# -----------------------------------------------------------------------------
# SUPER_ADMIN_EMAIL="owner@your-domain.com"
# SUPER_ADMIN_PASSWORD="at-least-12-characters"
# SUPER_ADMIN_NAME="Platform Owner"
# SUPER_ADMIN_BOOTSTRAP_SECRET=""
